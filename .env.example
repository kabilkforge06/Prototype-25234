# Redis Configuration (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Google Gemini API Configuration
GOOGLE_API_KEY=AIzaSyAPnRON-kREvhNtfT5lIDHPW9nAfMEW1Qw

# Vulnerability Scanner Configuration
